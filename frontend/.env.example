# ==============================================================================
# AquaLedger - Frontend Environment Configuration Template (.env.example)
# ==============================================================================
# NOTE: All Vite environment variables MUST be prefixed with VITE_ to be exposed
# to the browser client bundle.

# Backend REST API Base URL
# Development: http://localhost:5000/api/v1 (or http://localhost:3000/api/v1)
# Production: /api/v1 (relative path when served on same origin by Express)
VITE_API_URL=http://localhost:5000/api/v1

# Socket.IO Real-time Server URL
# Development: http://localhost:5000 (or http://localhost:3000)
# Production: leave blank or set to / to connect to the current origin
VITE_SOCKET_URL=http://localhost:5000
