# ==============================================================================
# AquaLedger - Backend Environment Configuration Template (.env.example)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas Connection String)
# Both MONGODB_URI and MONGO_URI are supported
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aqualedger?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aqualedger?retryWrites=true&w=majority

# JSON Web Token (JWT) Security
JWT_SECRET=aqualedger_production_jwt_secret_key_change_in_prod_2026
JWT_EXPIRES_IN=8h

# Cross-Origin Resource Sharing (CORS)
# Comma-separated origins for production (e.g. http://your-ec2-domain.com,http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Optional Local Administrator Bootstrap Seed
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_this_admin_password_123

# AWS SDK v3 Credentials (SNS & Lambda Dispatch)
# Required for automated leak alerts, valve cutoff, and dispatch SMS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS Lambda Anomaly Dispatch Function Name
LAMBDA_DISPATCH_FN=aqualedger-dispatch-sms

# Sandbox Verified Phone Number for SMS Dispatches (E.164 format: +<country_code><number>)
DISPATCH_PHONE_NUMBER=+1234567890
